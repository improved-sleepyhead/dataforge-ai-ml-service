{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.dataforge.ai/local-fallback/v0.1.0-demo/artifact_ref.schema.json",
  "title": "ArtifactRef",
  "type": "object",
  "required": [
    "artifact_id",
    "kind",
    "uri",
    "hash",
    "media_type",
    "size_bytes",
    "schema_version",
    "lineage"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "uri": {
      "type": "string",
      "pattern": "^s3://[^\\s]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "lineage": {
      "type": "object",
      "required": [
        "parent_version_id",
        "job_id",
        "config_hash",
        "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "parent_version_id": {
          "type": "string",
          "minLength": 1
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "config_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
