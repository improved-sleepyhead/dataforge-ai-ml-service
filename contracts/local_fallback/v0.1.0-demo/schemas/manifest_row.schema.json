{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.dataforge.ai/local-fallback/v0.1.0-demo/manifest_row.schema.json",
  "title": "ManifestRow",
  "type": "object",
  "required": [
    "object_id",
    "dataset_id",
    "version_id",
    "modality",
    "asset_uri",
    "hash",
    "metadata",
    "lineage"
  ],
  "additionalProperties": false,
  "properties": {
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "version_id": {
      "type": "string",
      "minLength": 1
    },
    "modality": {
      "type": "string",
      "enum": ["tabular", "text", "image", "video", "audio", "document_ocr", "multimodal"]
    },
    "asset_uri": {
      "type": "string",
      "pattern": "^s3://[^\\s]+$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "metadata": {
      "type": "object"
    },
    "lineage": {
      "type": "object",
      "required": ["source_artifact_id", "parent_version_id", "created_by_job_id", "config_hash"],
      "additionalProperties": false,
      "properties": {
        "source_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_version_id": {
          "type": "string",
          "minLength": 1
        },
        "created_by_job_id": {
          "type": "string",
          "minLength": 1
        },
        "config_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "annotation_uri": {
      "type": ["string", "null"],
      "pattern": "^s3://[^\\s]+$"
    },
    "label": {
      "type": ["string", "null"]
    },
    "split": {
      "type": ["string", "null"],
      "enum": ["train", "validation", "test", "holdout", "unknown", null]
    },
    "source_system": {
      "type": ["string", "null"]
    },
    "embedding_refs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
