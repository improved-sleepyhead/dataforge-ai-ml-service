{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.dataforge.ai/local-fallback/v0.1.0-demo/prediction_manifest.schema.json",
  "title": "PredictionManifest",
  "type": "object",
  "required": [
    "prediction_manifest_id",
    "dataset_id",
    "version_id",
    "model_id",
    "model_version",
    "task_type",
    "schema_version",
    "artifact",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "prediction_manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "version_id": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "enum": [
        "classification"
      ]
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "type": "object",
      "required": [
        "uri",
        "hash"
      ],
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^s3://[^\\s]+$"
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "object_id",
          "true_label",
          "predicted_label",
          "predicted_proba",
          "confidence",
          "split",
          "model_id",
          "model_version",
          "inference_timestamp"
        ],
        "additionalProperties": false,
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "true_label": {
            "type": "string",
            "minLength": 1
          },
          "predicted_label": {
            "type": "string",
            "minLength": 1
          },
          "predicted_proba": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "split": {
            "type": "string",
            "enum": [
              "train",
              "validation",
              "test",
              "holdout",
              "unknown"
            ]
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "model_version": {
            "type": "string",
            "minLength": 1
          },
          "inference_timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
